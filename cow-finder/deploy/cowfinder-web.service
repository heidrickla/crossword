[Unit]
Description=COW finder phone front end
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/Group and the paths below to match where the repo is checked out.
User=cowfinder
Group=cowfinder
WorkingDirectory=/opt/cowfinder/cow-finder
# The venv interpreter directly -- no shell, no activate, so the unit does not
# depend on a login environment that a systemd service does not have.
ExecStart=/opt/cowfinder/cow-finder/.venv/bin/python -m cowfinder.web --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=5

# Port 80 so a phone can reach it as a bare http://host with no port. Binding
# below 1024 normally needs root; this grants only that one capability instead,
# so the process still runs unprivileged as `cowfinder`.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# It only ever reads an uploaded photo from a temp file and writes nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/cowfinder/cow-finder

[Install]
WantedBy=multi-user.target
